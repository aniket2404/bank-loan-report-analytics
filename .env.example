# ---------------------------------------------------------------------------
# Bank Loan Report - example environment file
# Copy to .env and fill in your own values.  NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Microsoft SQL Server connection (only needed for the SQL / BI layers) ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=bank_loan_db
DB_TABLE=bank_loan_data

# SQL Server authentication.
# Leave DB_USER / DB_PASSWORD blank and set DB_TRUSTED_CONNECTION=yes to use
# Windows authentication instead (which is standard implementation).
DB_USER=your_sql_username
DB_PASSWORD=your_sql_password_here
DB_TRUSTED_CONNECTION=no

# ODBC driver installed on your machine
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Local paths (optional overrides) ---
DATA_DIR=./data
REPORTS_DIR=./reports
RAW_CSV_NAME=financial_loan.csv
