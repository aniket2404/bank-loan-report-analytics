# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.*

# --- Data ------------------------------------------------------------------
# The full dataset is not committed; see data/README.md for the download link.
data/raw/*
!data/raw/.gitkeep
*.csv
!data/sample/*.csv
*.xlsx
*.xls
!excel/*.md

# --- Generated outputs -----------------------------------------------------
# Generated figures ARE committed: a data-analytics portfolio repo is unusable
# to a reviewer who cannot see the charts without first running the pipeline.
# They are small (< 200 KB each), deterministic, and regenerated by
#   python -m bank_loan_report charts
!reports/figures/
!reports/figures/*.png
# Exported CSV tables are NOT committed - they are bulky, fully derived from the
# raw dataset, and regenerated by `python -m bank_loan_report export`.
reports/tables/
# Sample runs (`--sample`) write here so they cannot overwrite the committed
# full-dataset figures. 600-row output is never published.
reports/sample/
*.png
!reports/figures/*.png
*.jpg
*.jpeg
*.svg
*.pdf

